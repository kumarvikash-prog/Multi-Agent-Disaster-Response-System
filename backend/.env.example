ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Use 'postgresql+psycopg://' (psycopg 3 dialect) for both URLs.
# For Neon: use the *pooled* URL for DATABASE_URL and the *direct* URL for DATABASE_URL_DIRECT.
# For local dev: typically both are the same.
DATABASE_URL=postgresql+psycopg://localhost/disasterai_dev
DATABASE_URL_DIRECT=postgresql+psycopg://localhost/disasterai_dev

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
COOKIE_SECURE=false

# ── Google / LLM ──────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-1.5-flash
